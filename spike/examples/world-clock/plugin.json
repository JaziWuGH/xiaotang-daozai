{
  "id": "example.world-clock",
  "name": "世界时钟",
  "author": "岛仔",
  "version": "1.1.0",
  "api": 1,
  "runtime": "js",
  "entry": "main.js",
  "cover": "cover.png",
  "owner": "status",
  "capabilities": ["status.page", "settings", "timer"],
  "refreshSeconds": 300,
  "dataVersion": 1,
  "permissions": {},
  "timezones": true,
  "settings": [
    {
      "key": "cities",
      "label": "城市和时区",
      "type": "list",
      "default": "[{\"label\":\"北京时间\",\"zone\":\"Asia/Shanghai\"},{\"label\":\"东京\",\"zone\":\"Asia/Tokyo\"},{\"label\":\"新德里\",\"zone\":\"Asia/Kolkata\"},{\"label\":\"纽约\",\"zone\":\"America/New_York\"}]",
      "maxItems": 4,
      "item": [
        {"key":"label","label":"显示名称","type":"text","default":"北京时间"},
        {"key":"zone","label":"IANA 时区","type":"text","default":"Asia/Shanghai"}
      ]
    }
  ],
  "statusLayout": {
    "components": [{"type":"state"},{"type":"summary"},{"type":"clock"},{"type":"clock"},{"type":"clock"},{"type":"clock"}],
    "style": {"icon":"clock"}
  }
}
